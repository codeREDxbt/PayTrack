// ============================================================
// PayTrack – Firestore Security Rules
// ============================================================
// DEPLOY INSTRUCTIONS:
//   1. Go to Firebase Console → Firestore Database → Rules
//   2. Paste the contents of this file
//   3. Click "Publish"
//
// These rules enforce that each user can ONLY access their own
// documents. The server enforces ownership on every read/write.
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    // User is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Existing document belongs to the requesting user
    function isOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // New/updated document claims ownership as the requesting user
    function isAuthenticatedOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ── Employees ─────────────────────────────────────────────
    match /employees/{docId} {
      allow read:          if isOwner();
      allow create:        if isAuthenticatedOwner();
      allow update:        if isOwner() && isAuthenticatedOwner();
      allow delete:        if isOwner();
    }

    // ── Attendance ────────────────────────────────────────────
    match /attendance/{docId} {
      allow read:          if isOwner();
      allow create:        if isAuthenticatedOwner();
      allow update:        if isOwner() && isAuthenticatedOwner();
      allow delete:        if isOwner();
    }

    // ── Payroll ───────────────────────────────────────────────
    match /payroll/{docId} {
      allow read:          if isOwner();
      allow create:        if isAuthenticatedOwner();
      allow update:        if isOwner() && isAuthenticatedOwner();
      allow delete:        if isOwner();
    }

    // ── Settings / Holidays ───────────────────────────────────
    match /settings/{docId} {
      allow read, write:   if isAuthenticated() && docId == request.auth.uid;
    }

    match /holidays/{docId} {
      allow read:          if isOwner();
      allow create:        if isAuthenticatedOwner();
      allow update, delete: if isOwner();
    }

    // ── Deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
