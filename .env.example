# ================================================
# PayTrack - Environment Variables Template
# ================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Set the API base URL below
# 3. NEVER commit .env.local to git
# ================================================

# Leave this unset for local development: the client calls /api and Vite
# proxies it to the API on http://127.0.0.1:4000 (see vite.config.ts).
# Set it only for a deployed build, pointing at a public API:
#   VITE_API_URL=https://paytrack-api.onrender.com/api
# VITE_API_URL=http://127.0.0.1:4000/api
