# ================================================
# PayTrack - Environment Variables Template
# ================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in the values you need
# 3. NEVER commit .env.local to git
# ================================================

# Base URL of the Phase 5 REST API (server/index.js).
# Defaults to http://127.0.0.1:4000/api when unset.
VITE_API_URL=http://127.0.0.1:4000/api

# Optional: only needed if you wire Firebase Authentication through
# POST /auth/session. The default UI signs in with the API's own
# email + password session, so these may stay empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
